# Builder stage - compile the SPA
FROM node:24-alpine AS builder

WORKDIR /app

# Copy monorepo structure
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY artifacts/speed-date/package.json ./artifacts/speed-date/
COPY artifacts/speed-date/tsconfig.json ./artifacts/speed-date/
COPY artifacts/speed-date/vite.config.ts ./artifacts/speed-date/
COPY artifacts/speed-date/index.html ./artifacts/speed-date/
COPY artifacts/speed-date/src ./artifacts/speed-date/src
COPY artifacts/speed-date/public ./artifacts/speed-date/public
COPY artifacts/speed-date/components.json ./artifacts/speed-date/

# Install pnpm and dependencies
RUN npm install -g pnpm@12.6.0 && \
    pnpm install --frozen-lockfile --prefer-offline

# Build the SPA
RUN pnpm --filter @workspace/speed-date run build

# Production stage - serve the built app
FROM node:24-alpine

WORKDIR /app

# Copy server and built assets from builder
COPY artifacts/speed-date/server.js /app/server.js
COPY --from=builder /app/artifacts/speed-date/dist/public /app/dist/public
COPY artifacts/speed-date/package.json /app/

# Install express as production dependency
RUN npm install --production express@4.22.3 && npm cache clean --force

EXPOSE 8080

CMD ["node", "server.js"]

