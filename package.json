{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "ship:ready": "pnpm --filter @workspace/scripts run ship-ready",
    "ship:ready:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/ship-ready.ps1",
    "android:native": "pnpm --dir artifacts/flirtfest-mobile-native android",
    "start:native": "pnpm --dir artifacts/flirtfest-mobile-native start",
    "android:native:release": "pnpm --dir artifacts/flirtfest-mobile-native android:release",
    "android:native:bundle": "pnpm --dir artifacts/flirtfest-mobile-native android:bundle"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "expo": "~54.0.36",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@replit/revenuecat-sdk": "^5.0.0",
    "expo-router": "~6.0.17",
    "stripe": "^22.2.0",
    "stripe-replit-sync": "^1.0.0"
  }
}
