FROM node:24-alpine

WORKDIR /app

# Copy pre-built static assets and server
COPY artifacts/speed-date/dist/public /app/dist/public
COPY artifacts/speed-date/server.js /app/server.js
COPY artifacts/speed-date/package.json /app/

# Install express as a production dependency only
RUN npm install --production express@4.22.3 && npm cache clean --force

EXPOSE 8080

CMD ["node", "server.js"]

